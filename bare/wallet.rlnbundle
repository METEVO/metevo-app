  return true
}

exports.package = function* (url, source, artifacts, visited, opts = {}) {
  if (visited.has(url.href)) return false

  visited.add(url.href)

  if (source === null) {
    source = yield { module: url, artifact: false }

    if (source === null) return false
  }

  const info = JSON.parse(source)

  if (info) {
    yield {
      dependency: {
        url,
        source,
        type: constants.JSON,
        naturalType: constants.JSON,
        imports: {},
        lexer: { imports: [], exports: [] }
      }
    }

    if (info.assets && artifacts !== null) {
      yield {
        children: exports.assets(info.assets, url, artifacts, visited, opts),
        deferred: false
      }
    }

    return true
  }

  return false
}

exports.preresolved = function* (
  url,
  source,
  attributes,
  resolutions,
  artifacts,
  visited,
  opts = {}
) {
  const {
    builtinProtocol = 'builtin:',
    linkedProtocol = 'linked:',
    deferredProtocol = 'deferred:'
  } = opts

  const imports = resolutions[url.href]

  if (typeof imports !== 'object' || imports === null) return false

  attributes = attributes || {}

  const parentURL = url

  // The resolutions map leaves out the import attributes, so they are read
  // from the source instead.
  const lexed =
    opts.asset !== true && isJavaScript(moduleType(url, attributes, null, opts))
      ? lex(source)
      : null

  let info = null

  for (const [specifier, entry] of Object.entries(imports)) {
    const stack = [{ entry, addon: false, asset: false }]

    while (stack.length > 0) {
      const { entry, addon, asset } = stack.pop()

      if (typeof entry === 'string') {
        const url = new URL(entry)

        if (specifier === '#package') {
          const scope = yield* readPackage(url, opts)

          if (scope !== null && info === null) info = scope.info

          yield {
            children: exports.package(
              url,
              scope === null ? null : scope.source,
              artifacts,
              visited,
              opts
            ),
            deferred: false
          }
        } else if (url.protocol === deferredProtocol) {
          continue
        } else if (url.protocol === builtinProtocol || url.protocol === linkedProtocol) {
          if (addon) {
            assertImportedAddonContext(url, imports, parentURL, opts)

            if (artifacts !== null) addURL(artifacts.addons, url)
          }
        } else if (asset) {
          if (artifacts !== null) {
            const expanded = yield* expandAsset(url, artifacts, visited, { ...opts, importType: 0 })

            // Nothing to expand is left for the module itself to report.
            if (expanded === undefined) {
              addURL(artifacts.assets, url)

              yield {
                children: exports.module(url, null, {}, artifacts, visited, {
                  ...opts,
                  asset: true,
                  importType: 0
                }),
                deferred: true
              }
            }
          }
        } else {
          if (addon) {
            assertImportedAddonContext(url, imports, parentURL, opts)

            if (artifacts !== null) addURL(artifacts.addons, url)
          }

          yield {
            children: exports.module(
              url,
              null,
              addon ? { type: 'addon' } : importAttributes(lexed, specifier, imports),
              artifacts,
              visited,
              {
                ...opts,
                importType: 0
              }
            ),
            deferred: false
          }
        }
      } else {
        for (const [condition, child] of Object.entries(entry)) {
          stack.push({
            entry: child,
            addon: addon || condition === 'addon',
            asset: asset || condition === 'asset'
          })
        }
      }
    }
  }

  const type = moduleType(url, attributes, info, opts)

  const lexer = { imports: [], exports: [] }

  if (lexed !== null && isJavaScript(type)) {
    lexer.imports = lexed.imports
    lexer.exports = lexed.exports
  }

  yield {
    dependency: withWASI(
      {
        url: exports.alias(url, opts),
        source,
        type,
        naturalType: naturalModuleType(url, attributes, info, type, opts),
        imports: compressImportsMap(imports),
        lexer
      },
      opts
    )
  }

