exports.self = Bare.Thread.self

exports.prepare = function prepare(entry, opts) {
  entry = entryURL(entry)

  const bundle = new Bundle()

  const dependencies = traverse(
    entry,
    { resolutions: module.resolutions, resolve: traverse.resolve.bare },
    readModule,
    listPrefix,
    probeModule
  )[Symbol.iterator]()

  let next = dependencies.next()

  while (next.done !== true) {
    const { url, source, type, imports } = next.value

    // Native addons are loaded from disk, so embedding them is dead weight.
    if (type !== traverse.constants.ADDON || isWebAssembly(url)) {
      bundle.write(url.href, source, {
        main: url.href === entry.href,
        imports
      })
    }

    next = dependencies.next()
  }

  bundle.addons = next.value.addons.map((url) => url.href)
  bundle.assets = next.value.assets.map((url) => url.href)

  return bundle.toBuffer(opts)
}

exports.mountFor = function mountFor(entry) {
  const { href, pathname, search, hash } = entryURL(entry)

  return href.slice(0, href.length - pathname.length - search.length - hash.length) + '/'
