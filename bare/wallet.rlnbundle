   * @returns {Promise<string>} The address.
   */
  async getAddress () {
    throw new NotImplementedError('getAddress()')
  }

  /**
   * Disposes the signer and clears any secret material from memory.
   */
  dispose () {
    throw new NotImplementedError('dispose()')
  }
}
