/**
 * Payment-boundary guards shared by every wallet runtime (Node tooling,
 * the app bundle and the Bare worklet). This module must stay free of
 * wallet-runtime imports: it is bundled into the React Native app, where
 * the WDK module resolves to a Node-only binding.
 */
/** Thrown before a proposal reaches the node: nothing was submitted and no
 * funds moved, so callers must not treat this as an ambiguous outcome. */
export class PaymentValidationError extends Error {
    constructor(message) {
        super(message);
        this.name = 'PaymentValidationError';
    }
}
/** Lightning invoices carry an "ln" human-readable prefix; anything else is
 * not payable and is rejected before the node is touched. */
const BOLT11_INVOICE_PATTERN = /^ln[a-z0-9]{6,}/i;
export function assertPayableInvoice(invoice) {
    if (!BOLT11_INVOICE_PATTERN.test(invoice)) {
        throw new PaymentValidationError('the proposal is not a payable lightning invoice; nothing was submitted');
    }
}
export async function getPaymentStatus(account, paymentHash) {
    if (paymentHash.length === 0) {
        return 'unknown';
    }
    await account.sync();
    const payments = await account.listPayments();
    const list = Array.isArray(payments)
        ? payments
        : payments?.payments;
    if (!Array.isArray(list)) {
        return 'unknown';
    }
    const match = list.find((entry) => {
        const hash = String(entry?.payment_hash ??
            entry?.paymentHash ??
            '').toLowerCase();
        return hash === paymentHash.toLowerCase();
    });
    if (match === undefined) {
        return 'unknown';
    }
    const status = String(match?.status ?? 'Pending');
    if (status === 'Succeeded') {
        return 'settled';
    }
    if (status === 'Failed') {
        return 'failed';
    }
    return 'pending';
}
import WalletManagerRgbLightning from '@utexo/wdk-rgb-lightning';
// Payment-boundary guards live in their own runtime-agnostic module (the
// React Native app bundle imports them without pulling the WDK binding in).
import { assertPayableInvoice, getPaymentStatus, PaymentValidationError, } from './paymentGuard';
export { assertPayableInvoice, getPaymentStatus, PaymentValidationError, };
const DEFAULT_USDM_TICKER = 'USDM';
export async function createMetevoWallet(mnemonic, config) {
    const manager = new WalletManagerRgbLightning(mnemonic, {
        network: config.network,
        dataDir: config.dataDir,
        ldkPeerListeningPort: config.ldkPeerListeningPort,
        daemonListeningPort: config.daemonListeningPort,
        ...(config.lspBaseUrl ? { lspBaseUrl: config.lspBaseUrl } : {}),
        ...(config.lspBearerToken ? { lspBearerToken: config.lspBearerToken } : {}),
    });
    const account = await manager.getAccount(0);
    await account.unlock({
        ldk_chain_sync: {
            mode: 'BlockSync',
            config: {
                bitcoind_rpc_username: config.bitcoindRpcUsername,
                bitcoind_rpc_password: config.bitcoindRpcPassword,
                bitcoind_rpc_host: config.bitcoindRpcHost,
                bitcoind_rpc_port: config.bitcoindRpcPort,
            },
        },
        indexer_url: config.indexerUrl,
        proxy_endpoint: config.proxyEndpoint,
        announce_addresses: [],
        announce_alias: 'metevo-wallet',
    });
    return { manager, account };
}
export async function getMetevoWalletStatus(account, usdmAssetId) {
    const info = (await account.getNodeInfo());
    const balance = (await account.getBalanceDetails(false));
    let usdmBaseUnits = null;
    let usdmChannelReady = false;
    if (usdmAssetId) {
        usdmBaseUnits = Number(await account.getTokenBalance(usdmAssetId));
        const channels = (await account.listChannels());
        const list = Array.isArray(channels) ? channels : channels?.channels ?? [];
        usdmChannelReady = list.some((c) => c?.peer_pubkey && (c.is_usable ?? c.ready) === true &&
            (c.asset_id ?? null) === usdmAssetId);
    }
    return {
        pubkey: info?.pubkey ?? null,
        btcSpendableSat: Number(balance?.vanilla?.spendable ?? 0),
        usdmBaseUnits,
        usdmChannelReady,
        unlocked: true,
    };
}
export async function ensureColorableUtxos(account, options = {}) {
    const num = options.num ?? 2;
    const sizeSat = options.sizeSat ?? 30050;
    const feeRate = options.feeRate ?? 2;
    try {
        await account.createUtxos({ up_to: true, num, size: sizeSat, fee_rate: feeRate, skip_sync: false });
    }
    catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        if (message.includes('Allocations already available') || message.includes('AllocationsAlreadyAvailable')) {
            return;
        }
        throw error;
    }
}
export async function createUsdmReceiveInvoice(account, options) {
    const aware = options.assetId !== null;
    const request = {
        min_confirmations: 1,
        witness: aware,
        duration_seconds: options.durationSeconds ?? 3600,
    };
    if (aware) {
        request.asset_id = options.assetId;
        if (options.amountBaseUnits !== null) {
            request.assignment_kind = 'Fungible';
            request.assignment_amount = options.amountBaseUnits;
        }
    }
    const response = (await account.createRgbInvoice(request));
    const invoice = response?.invoice ?? response?.recipient_id;
    if (typeof invoice !== 'string' || invoice.length === 0) {
        throw new Error('createRgbInvoice returned no invoice');
    }
    return { invoice, kind: aware ? 'witness' : 'blind' };
}
/**
 * Advance the node's RGB transfer state machine and report the current
 * transfer list for the asset. The node requires periodic refreshTransfers
 * calls to progress pending transfers (incoming and outgoing); the
 * settlement watcher polls this until a transfer is Settled/Failed.
 *
 * Transfer entries come back untyped from the binding; only the verified
 * fields are mapped, unknown shapes are skipped instead of guessed.
 */
export async function refreshWalletTransfers(account, assetId) {
    // skip_sync=false keeps the node honest about on-chain state before it
    // settles transfers; filter=[] refreshes every pending transfer.
    await account.refreshTransfers({ skip_sync: false, filter: [] });
    if (assetId === null) {
        return [];
    }
    const response = (await account.listTransfers(assetId));
    const list = Array.isArray(response)
        ? response
        : response?.transfers;
    if (!Array.isArray(list)) {
        return [];
    }
    const mapped = [];
    for (const entry of list) {
        if (typeof entry !== 'object' || entry === null) {
            continue;
        }
        const record = entry;
        const transferId = String(record.transfer_id ?? record.transferId ?? record.txid ?? '');
        if (transferId.length === 0) {
            continue;
        }
        const amountRaw = record.receive_amount ?? record.amount ?? null;
        mapped.push({
            transferId,
            kind: String(record.kind ?? ''),
            status: String(record.status ?? ''),
            amount: typeof amountRaw === 'number' && Number.isFinite(amountRaw)
                ? amountRaw
                : null,
        });
    }
    return mapped;
}
/**
 * Creates the receiver's USDm Lightning invoice (the payer pays it over
 * the LSP channel or a direct one). With an amount the invoice pins the
 * asset amount (and lets the node derive the msat demand); without one it
 * stays amount-free (blind receive). Uses the verified camelCase request
 * shape { expirySec, assetId?, assetAmount? } of the WDK account.
 */
export async function createUsdmLightningInvoice(account, usdmAssetId, amountBaseUnits) {
    const response = (await account.createLightningInvoice({
        expirySec: 3600,
        ...(usdmAssetId !== null ? { assetId: usdmAssetId } : {}),
        ...(amountBaseUnits !== null ? { assetAmount: amountBaseUnits } : {}),
    }));
    const invoice = String(response?.invoice ?? '');
    if (invoice.length === 0) {
        throw new Error('createLightningInvoice returned no invoice');
    }
    const paymentHash = String(response?.payment_hash ?? response?.paymentHash ?? '');
    return {
        invoice,
        paymentHash: paymentHash.length > 0 ? paymentHash : null,
    };
}
/**
 * Whether this node has a usable channel with exactly this peer (the
 * direct-route condition for in-person payments over the local link).
 */
export async function hasUsableChannelWith(account, peerPubkey) {
    const channels = (await account.listChannels());
    const list = Array.isArray(channels) ? channels : channels?.channels ?? [];
    const target = peerPubkey.toLowerCase();
    return list.some((c) => String(c?.peer_pubkey ?? '').toLowerCase() === target &&
        (c.is_usable ?? c.ready) === true);
}
export async function findAssetIdByTicker(account, ticker = DEFAULT_USDM_TICKER) {
    const assets = (await account.listAssets(['Ifa', 'Nia']));
    const groups = [assets?.ifa ?? [], assets?.nia ?? []];
    for (const group of groups) {
        for (const asset of group) {
            if (String(asset?.ticker ?? '').toLowerCase() === ticker.toLowerCase()) {
                return asset.asset_id;
            }
        }
    }
    return null;
}
export async function shutdownMetevoWallet(wallet) {
    try {
        await wallet.account.shutdown();
    }
    finally {
        wallet.manager.dispose();
    }
}
{
  "name": "metevo-worklet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "wallet-worklet.js"
}
/**
 * The METEVO wallet worklet: hosts the prepared wallet services inside a
 * Bare runtime on the mobile device.
 *
 * Protocol (JSON lines over BareKit IPC):
 *   app -> worklet: {"id":1,"method":"openWallet","params":{...}}\n
 *   worklet -> app: {"id":1,"ok":true,"result":{...}}\n
 *                   {"id":1,"ok":false,"error":"..."}\n
 *   worklet -> app: {"event":"progress","step":"...","message":"..."}\n
 *
 * The app owns SecureStore, biometrics and the provisioned device config
 * file; it sends the wallet configuration and the seed as command
 * parameters. They live in worklet memory only while the node runs.
 */
import {
  assertPayableInvoice,
  createMetevoWallet,
  createUsdmLightningInvoice,
  findAssetIdByTicker,
  getMetevoWalletStatus,
  getPaymentStatus,
  hasUsableChannelWith,
  refreshWalletTransfers,
  shutdownMetevoWallet,
} from './compiled/services/metevo/wallet.js'

const { IPC } = BareKit

// On Android a worklet abort takes the whole app process down with it.
// Never let an unexpected async failure reach the runtime's default abort:
// report it over IPC so the app can log it and surface it to the user.
function reportFatal(scope, cause) {
  const message = cause instanceof Error ? `${cause.name}: ${cause.message}` : String(cause)
  try {
    console.error(`[worklet] ${scope}: ${message}`)
  } catch {
    /* console may be unavailable late in shutdown */
  }
  try {
    IPC.write(JSON.stringify({ event: 'worklet-error', scope, message }) + '\n')
  } catch {
    /* IPC already closed - nothing more we can do */
  }
}

if (typeof process !== 'undefined' && typeof process.on === 'function') {
  process.on('uncaughtException', (cause) => reportFatal('uncaughtException', cause))
  process.on('unhandledRejection', (cause) => reportFatal('unhandledRejection', cause))
}

let wallet = null
let usdmAssetId = null

const CHANNEL_POLL_INTERVAL_MS = 2_000
const DEFAULT_CHANNEL_TIMEOUT_MS = 120_000

function waitFor(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

function emitProgress(step, message) {
  IPC.write(JSON.stringify({ event: 'progress', step, message }) + '\n')
}

function requireOpenWallet() {
  if (wallet === null) {
    throw new Error('the wallet is not open')
  }
  return wallet
}

/**
 * The module's designed LSP flow: bootstrapLsp connects the peer, waits for
 * peer visibility and runs the APay provisioning against lspBaseUrl. Falls
 * back to a plain peer connect when the beta runtime lacks the method.
 */
async function bootstrapLspIfAvailable(account, peerUri) {
  if (typeof account.bootstrapLsp === 'function') {
    await account.bootstrapLsp({
      peerPubkeyAndAddr: peerUri,
      waitForPeerMs: 30_000,
      pollIntervalMs: 2_000,
    })
    return
  }
  if (typeof account.connectPeer === 'function') {
    await account.connectPeer(peerUri)
  }
}

async function openWallet({ mnemonic, walletConfig, lspPeerUri, channelTimeoutMs }) {
  emitProgress('opening-node', 'Opening…')
  wallet = await createMetevoWallet(mnemonic, walletConfig)
  usdmAssetId = await findAssetIdByTicker(wallet.account)

  emitProgress('connecting-lsp', 'Connecting to the METEVO LSP…')
  if (lspPeerUri) {
    await bootstrapLspIfAvailable(wallet.account, lspPeerUri)
  }
  await waitFor(CHANNEL_POLL_INTERVAL_MS)

  emitProgress('provisioning-channel', 'Opening your USDm channel…')
  // The LSP provisions channels on a cron, so the wait is best-effort:
  // timing out is not an error - the app keeps polling the wallet status.
  const deadline = Date.now() + (channelTimeoutMs ?? DEFAULT_CHANNEL_TIMEOUT_MS)
  let status = await getMetevoWalletStatus(wallet.account, usdmAssetId)
  while (!status.usdmChannelReady && Date.now() < deadline) {
    await waitFor(CHANNEL_POLL_INTERVAL_MS)
    status = await getMetevoWalletStatus(wallet.account, usdmAssetId)
  }
  emitProgress('ready', 'Wallet connected')
  return { channelReady: status.usdmChannelReady }
}

async function readStatus() {
  if (wallet === null) {
    return {
      nodePubkey: null,
      btcSpendableSat: 0,
      balanceUsdmBaseUnits: null,
      channelReady: false,
    }
  }
  const status = await getMetevoWalletStatus(wallet.account, usdmAssetId)
  return {
    nodePubkey: status.pubkey,
    btcSpendableSat: status.btcSpendableSat,
    balanceUsdmBaseUnits: status.usdmBaseUnits,
    channelReady: status.usdmChannelReady,
  }
}

async function submitPayment({ invoice }) {
  // Real-node boundary: a non-bolt11 proposal fails before sendPayment.
  assertPayableInvoice(invoice)
  const response = await requireOpenWallet().account.sendPayment({ invoice })
  const paymentHash = String(response?.payment_hash ?? response?.paymentHash ?? '')
  return { paymentHash: paymentHash.length > 0 ? paymentHash : null }
}

async function checkPayment({ paymentHash }) {
  return getPaymentStatus(requireOpenWallet().account, paymentHash)
}

async function refreshTransfers() {
  // The node needs periodic refreshTransfers calls to settle pending RGB
  // transfers; the settlement watcher in the app polls this handler.
  return refreshWalletTransfers(requireOpenWallet().account, usdmAssetId)
}

async function createUsdmInvoice({ amountBaseUnits }) {
  return createUsdmLightningInvoice(
    requireOpenWallet().account,
    usdmAssetId,
    amountBaseUnits ?? null,
  )
}

async function checkUsableChannelWith({ peerPubkey }) {
  return hasUsableChannelWith(requireOpenWallet().account, peerPubkey)
}

async function connectPeer({ peerUri }) {
  await requireOpenWallet().account.connectPeer(peerUri)
}

async function shutdown() {
  if (wallet !== null) {
    await shutdownMetevoWallet(wallet)
    wallet = null
  }
}

const handlers = {
  openWallet,
  readStatus,
  submitPayment,
  checkPayment,
  refreshTransfers,
  createUsdmInvoice,
  hasUsableChannelWith: checkUsableChannelWith,
  connectPeer,
  shutdown,
}

let receiveBuffer = ''

async function dispatchFrame(line) {
  let request
  try {
    request = JSON.parse(line)
  } catch {
    return
  }
  const handler = handlers[request.method]
  try {
    if (typeof handler !== 'function') {
      throw new Error(`unknown wallet method: ${String(request.method)}`)
    }
    const result = await handler(request.params ?? {})
    IPC.write(JSON.stringify({ id: request.id, ok: true, result }) + '\n')
  } catch (cause) {
    const error = cause instanceof Error ? cause.message : String(cause)
    IPC.write(JSON.stringify({ id: request.id, ok: false, error }) + '\n')
  }
}

IPC.on('data', (chunk) => {
  receiveBuffer += Buffer.from(chunk).toString('utf8')
  let newlineIndex = receiveBuffer.indexOf('\n')
  while (newlineIndex !== -1) {
    const line = receiveBuffer.slice(0, newlineIndex)
    receiveBuffer = receiveBuffer.slice(newlineIndex + 1)
    if (line.length > 0) {
      void dispatchFrame(line)
    }
    newlineIndex = receiveBuffer.indexOf('\n')
  }
})
