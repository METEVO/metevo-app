  ref.increment()

  const values = []

  let remaining = maxSetLength

  const { value: size } = attempt(() => set.size)

  attempt(() => {
    for (const entry of set) {
      if (remaining-- === 0) {
        values.push(
          new InspectSuspension(size - values.length, depth + 1, {
