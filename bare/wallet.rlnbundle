  }

  _onconnection(socket) {
    this.emit('connection', new exports.Socket(this._opts)._attach(this._type, socket))
  }

  _onerror(err) {
    this._state &= ~constants.state.BINDING

    this.emit('error', err)
  }

  _onclose() {
    this._state &= ~constants.state.BINDING
    this._state &= ~constants.state.BOUND

    this.emit('close')
  }
}

