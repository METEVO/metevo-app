function inspectWeakSet(weakSet, ref, depth, opts) {
  const header = (nameOf(weakSet) || 'WeakSet') + ' { '

  return new InspectSequence(
    header,
    ' }',
    ' ',
    [new InspectLeaf('<items unknown>', styles.special, depth + 1, opts)],
    ref,
    depth,
    opts
