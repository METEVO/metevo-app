    const n = Math.min(end - offset, frame.length - this._payloadOffset)

    this._reserve(this._payloadOffset + n, frame.length)

    const payload = this._payload

    if (frame.mask === null) {
      payload.set(data.subarray(offset, offset + n), this._payloadOffset)
    } else {
      unmask(data, offset, payload, this._payloadOffset, n, frame.mask)
    }

    if (
      this._validating &&
      this._validator.push(payload, this._payloadOffset, this._payloadOffset + n) === false
    ) {
      this._fail(errors.INVALID_UTF8('Text message payload must be valid UTF-8'))

      return end
    }

    this._payloadOffset += n

    if (this._payloadOffset === frame.length) {
      try {
        this._oncomplete(payload)
      } catch (err) {
        this._fail(err)

        return end
      }
    }

    return offset + n
  }

  // Makes room for what has arrived of the payload. The buffer starts small and
  // doubles as it fills, so a peer that declared a large frame is only ever
  // committed to as much as it has actually sent, while a frame arriving in
  // ordinary reads has room made for it once.
  _reserve(needed, total) {
    const payload = this._payload

    let capacity = payload === null ? 0 : payload.byteLength

    if (capacity >= needed) return

    if (capacity === 0) capacity = MIN_PAYLOAD_CAPACITY

    while (capacity < needed) capacity *= 2

    if (capacity > total) capacity = total

    // Left uninitialized: nothing past what has been filled is ever read, and a
    // payload is only handed on once every byte of it has been written.
    this._payload = Buffer.allocUnsafe(capacity)

    if (payload !== null) this._payload.set(payload.subarray(0, this._payloadOffset))
  }

  _oncomplete(payload) {
    const frame = this._frame

    this._frame = null
    this._payload = null
    this._payloadOffset = 0

    const validating = this._validating

    this._validating = false

    switch (frame.opcode) {
      case opcode.CLOSE:
        return this._oncloseframe(payload)

      case opcode.PING:
        return this._onping(payload)

      case opcode.PONG:
        this.emit('pong', payload)
        return
    }

    // Only text and binary are left, and either one carries part of a message.
    if (frame.fin === false) {
      this._fragmented += payload.byteLength

      this._fragments.push(payload)

      return
    }

    // A sequence left half read is as much a violation as a byte that could
    // never have belonged to one.
    if (validating && this._validator.complete === false) {
      throw errors.INVALID_UTF8('Text message must not end part way through a sequence')
    }

    if (this._message === -1) {
      this.emit('message', payload, frame.opcode === opcode.BINARY)

      return this._push(payload)
    }

    this._fragments.push(payload)

    const message = Buffer.concat(this._fragments)
    const binary = this._message === opcode.BINARY

    this._fragments = []
    this._fragmented = 0
    this._message = -1

    this.emit('message', message, binary)

    this._push(message)
  }

  // https://datatracker.ietf.org/doc/html/rfc6455#section-5.5.1
  _oncloseframe(payload) {
    if (payload.byteLength === 1) {
      throw errors.INVALID_CLOSE_PAYLOAD('Close payload must be empty or at least 2 bytes')
    }

    if (payload.byteLength >= 2) {
      const code = payload.readUInt16BE(0)

      if (isValidStatus(code) === false) {
        throw errors.INVALID_CLOSE_STATUS(`Close status ${code} must not be sent`)
      }

      const reason = payload.subarray(2)

      if (UTF8Validator.validate(reason) === false) {
        throw errors.INVALID_UTF8('Close reason must be valid UTF-8')
      }

      this._closeCode = code
      this._closeReason = retain(reason)
    } else {
      this._closeCode = status.NO_STATUS_RECEIVED
    }

    this._closed = true

    this.push(null)
    this.end()

    this._endsoon()
  }

  _onping(payload) {
    // Nothing may follow our own close frame, so a ping that arrives after it
    // goes unanswered, though the application is still told of it.
    if (this._ended === false) {
      if (this._corked) {
        // A peer is owed an answer to its most recent ping, not to every one.
        this._pendingPong = payload
      } else {
        this._writeControl(opcode.PONG, payload)
      }
    }

    this.emit('ping', payload)
  }

  // Backpressure has to reach the socket: `maxPayload` bounds a message, not
  // how many of them a peer may leave waiting for a consumer that is behind.
  _push(payload) {
    if (this.push(payload) === false && this._paused === false) {
      this._paused = true

      this._socket.pause()
    }
  }

  _read() {
    if (this._paused) {
      this._paused = false

      this._socket.resume()
    }
  }

  // What is left of the message budget for the frame now arriving, so that one
  // which would carry the message past it is refused on its header rather than
  // once its payload has been buffered and copied out.
  _remaining() {
    if (this._maxPayload < 0) return -1

    return this._maxPayload - this._fragmented
  }

  _fail(err) {
    if (this._closed === false) {
      this._closed = true

      // A close frame already on its way is the last word, since nothing may
      // follow it, even what went wrong after it was sent.
      if (
        this._ended === false &&
        err.status &&
        this._socket !== null &&
        isWritable(this._socket)
      ) {
        this._writeControl(opcode.CLOSE, encodeStatus(err.status))

        this._ended = true
      }
    }

    this.destroy(err)
  }

  _ondrain() {
    this._corked = false

    if (this._pendingPong !== null) {
      const payload = this._pendingPong
      this._pendingPong = null

      if (this._closed === false && this._ended === false && this._socket !== null) {
        this._writeControl(opcode.PONG, payload)
      }
    }

    if (this._pendingWrite === null) return
    const cb = this._pendingWrite
    this._pendingWrite = null
    cb(null)
  }

  _open(cb) {
    if (this._socket === null) this._pendingOpen = cb
    else cb(null)
  }

  _write(data, encoding, cb) {
    if (encoding !== 'buffer' && encoding !== 'utf8') {
      return cb(errors.INVALID_ENCODING())
    }

    if (ArrayBuffer.isView(data) === false) {
      return cb(errors.INVALID_ENCODING('Data must be a string or a buffer'))
    }

    const frame = new Frame(
      encoding === 'buffer' ? opcode.BINARY : opcode.TEXT,
      Buffer.coerce(data),
      { mask: this._mask }
    )

    if (this._socket.write(frame.toBuffer())) cb(null)
    else {
      this._corked = true
      this._pendingWrite = cb
    }
  }

  // https://datatracker.ietf.org/doc/html/rfc6455#section-5.5.1
  _closePayload() {
    if (this._closed === false) {
      return this._localClosePayload || encodeStatus(status.NORMAL_CLOSURE)
    }

    // A peer that sent no status gets none back, since 1005 stands for the
    // absence of one and may never go on the wire.
    if (this._closeCode === status.NO_STATUS_RECEIVED) return EMPTY

    return Buffer.concat([encodeStatus(this._closeCode), this._closeReason])
  }

  _final(cb) {
    if (this._socket === null) return cb(null)

    // Not shared: a client masks every frame it sends and a server masks none.
    const frame = new Frame(opcode.CLOSE, this._closePayload(), { mask: this._mask })

    this._socket.write(frame.toBuffer())

    this._ended = true

    // The connection stays up until the peer has answered, since closing it now
    // would race the close frame it owes us and leave every close looking as
    // abrupt as a connection that was dropped. It has until the timer to reply.
    if (this._closed === false && this._closeTimeout > 0) {
      this._closeTimer = setTimeout(() => this.destroy(), this._closeTimeout)

      this._closeTimer.unref()
    }

    this._endsoon()

    cb(null)
  }

  // https://datatracker.ietf.org/doc/html/rfc6455#section-7.1.1
  //
  // The connection comes down once both close frames have been exchanged, which
  // either end of the pair may complete. Ending naturally does not destroy the
  // stream, so this is the only place the socket is let go of on that path.
  _endsoon() {
    if (this._ended === false || this._closed === false) return

    if (this._closeTimer !== null) {
      clearTimeout(this._closeTimer)
      this._closeTimer = null
    }

    destroySoon(this._socket, this._closeTimeout)
  }

  _predestroy() {
    // A write waiting on `drain` never sees one once the socket is gone, and
    // the stream cannot finish destroying until its callback has run.
    if (this._pendingWrite !== null) {
      const cb = this._pendingWrite
      this._pendingWrite = null

      cb(null)
    }

    if (this._idleTimer !== null) {
      clearTimeout(this._idleTimer)
      this._idleTimer = null
    }

    if (this._closeTimer !== null) {
      clearTimeout(this._closeTimer)
      this._closeTimer = null
    }

    this._fragments = []
    this._fragmented = 0
    this._message = -1
    this._headerLength = 0
    this._frame = null
    this._payload = null
    this._payloadOffset = 0

    if (this._request !== null) {
      const req = this._request
      this._request = null

      if (req.socket) req.socket.destroy()
    }

    if (this._socket === null) return

    // Flush a close frame we have queued; otherwise the peer sees the
    // connection vanish rather than close.
    if (this._ended) destroySoon(this._socket, this._closeTimeout)
    else this._socket.destroy()
  }
}

// https://datatracker.ietf.org/doc/html/rfc6455#section-4.1
exports.handshake = function handshake(req, opts = {}, cb) {
  if (typeof opts === 'function') {
    cb = opts
    opts = {}
  }

  const { timeout = HANDSHAKE_TIMEOUT } = opts

  const key = crypto.randomBytes(16).toString('base64')

  req.headers = {
    ...req.headers,
    Connection: 'Upgrade',
    Upgrade: 'websocket',
    'Sec-WebSocket-Version': 13,
    'Sec-WebSocket-Key': key
  }

  // The request keeps emitting after the handshake has been settled, so only
  // whichever of the four arrives first is heard.
  let settled = false

  let timer = null

  const done = (err) => {
    if (settled) return

    settled = true

    if (timer !== null) clearTimeout(timer)

    cb(err)
  }

  // Nothing is read from the connection until the handshake is through, so a
  // peer that accepts it and then says nothing would otherwise be waited on
  // forever, the idle timer not being armed until the socket has been handed
  // over.
  if (timeout > 0) {
    timer = setTimeout(() => done(errors.CONNECTION_TIMEOUT('Handshake timed out')), timeout)

    timer.unref()
  }

  req.on('upgrade', (res, socket, head) => {
    // The response is nobody's to hear from once the socket has been handed
    // over, but the connection underneath goes on reporting to it, and an
    // unheard 'error' is not catchable and ends the process.
    res.on('error', noop)

    if (res.statusCode !== 101) {
      return done(errors.INVALID_UPGRADE_STATUS(`Expected status 101, got ${res.statusCode}`))
    }

    const upgrade = res.headers.upgrade

    if (typeof upgrade !== 'string' || upgrade.toLowerCase() !== 'websocket') {
      return done(errors.INVALID_UPGRADE_HEADER())
    }

    const digest = crypto.createHash('sha1').update(key).update(GUID).digest('base64')

    if (res.headers['sec-websocket-accept'] !== digest) {
      return done(errors.INVALID_ACCEPT_HEADER())
    }

    // https://datatracker.ietf.org/doc/html/rfc6455#section-4.1
    const negotiated = checkNegotiated(req, res)

    if (negotiated) return done(negotiated)

    if (head.byteLength) socket.unshift(head)

    done(null)
  })

  // A peer that answers without upgrading, whether it refused the handshake or
  // never spoke the protocol, never reaches `upgrade`. Without this the
  // handshake would simply never finish.
  req.on('response', (res) => {
    res.on('error', noop)

    done(errors.INVALID_UPGRADE_STATUS(`Expected an upgrade, got status ${res.statusCode}`))
  })

  req.on('error', (err) => {
    done(errors.NETWORK_ERROR('Network error', err))
  })

  req.end()
}

// A server may only come back with what the client put on the table. No
// extension is ever offered, since one would change how every frame is read,
// and a subprotocol only if the caller asked for it by name.
function checkNegotiated(req, res) {
  const extensions = res.headers['sec-websocket-extensions']

  if (extensions) {
    return errors.UNEXPECTED_EXTENSION(`No extension was offered, got '${extensions}'`)
  }

  const protocol = res.headers['sec-websocket-protocol']

  if (protocol === undefined) return null

  const offered = req.headers['sec-websocket-protocol']

  if (offered) {
    for (const token of String(offered).split(',')) {
      if (token.trim() === String(protocol).trim()) return null
    }
  }

  return errors.UNEXPECTED_PROTOCOL(`Subprotocol '${protocol}' was not offered`)
}

// https://datatracker.ietf.org/doc/html/rfc6455#section-5.2
function isKnownOpcode(op) {
  return (
    op === opcode.CONTINUATION ||
    op === opcode.TEXT ||
    op === opcode.BINARY ||
    op === opcode.CLOSE ||
    op === opcode.PING ||
    op === opcode.PONG
