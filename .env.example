# Template for new machines. Copy to .env (baseline) and optionally .env.local
# (machine-local overrides). See .env for the full annotated list of variables.

EXPO_PUBLIC_METEVO_ENV=dev
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_RECORDING_SILENCE_TIMEOUT_MS=3000
EXPO_PUBLIC_RECORDING_SILENCE_THRESHOLD_DB=-40
EXPO_PUBLIC_RECORDING_METER_POLL_MS=150
EXPO_PUBLIC_RECORDING_ALLOW_AUTO_STOP=true

# Wallet session: "mock" simulates setup for Expo Go demos; "wdk" drives the
# real @utexo/wdk-rgb-lightning node (debug APK builds); "remote" drives an
# rgb-lightning-node daemon over REST (see README: two phones on regtest).
EXPO_PUBLIC_WALLET_MODE=mock
# Biometric prompt before the wallet session opens (off by default: remote
# mode keeps no secret on the phone, the node does).
EXPO_PUBLIC_WALLET_AUTH=false
# How often (ms) the home shell refreshes balances and the connection state.
EXPO_PUBLIC_WALLET_STATUS_POLL_MS=10000

# Remote node (EXPO_PUBLIC_WALLET_MODE=remote). The phone-side URL stays the
# same for every phone; `adb reverse` maps it to that phone's own node.
# Must be https:// when EXPO_PUBLIC_METEVO_ENV=prod. A bearer token, when the
# node runs with authentication, is provisioned on the device (never here).
EXPO_PUBLIC_RLN_NODE_URL=http://localhost:3001
EXPO_PUBLIC_RLN_REQUEST_TIMEOUT_MS=15000
EXPO_PUBLIC_RLN_USDM_TICKER=USDM
# Optional: pin the asset id instead of resolving it by ticker.
EXPO_PUBLIC_RLN_USDM_ASSET_ID=
# Optional: peer (pubkey@host:port) connected when the wallet opens.
EXPO_PUBLIC_RLN_PEER_URI=
EXPO_PUBLIC_WALLET_NETWORK=regtest
# wdk-mode hosting: "inprocess" (Node tooling/scripts) or "bare" (the node
# runs in a Bare worklet inside the mobile app). NOTE: "bare" crashes on
# Android today with a confirmed native SIGABRT inside react-native-bare-kit
# - see docs/known-issues/wallet-bare-android-crash.md for the full
# investigation (the native addon pairing itself is verified fine on
# Node.js; the bug is in Bare's Android callback dispatch). Keep
# "inprocess" as the on-device default until that upstream bug is fixed.
EXPO_PUBLIC_WALLET_TRANSPORT=inprocess
# How long setup waits for the LSP cron to provision the USDm channel
# before opening the home shell without one (readiness shows in status).
EXPO_PUBLIC_CHANNEL_PROVISION_TIMEOUT_MS=120000

# Network target preset: "regtest" (local metevo-infra) or "signet"
# (public signet LSP). Selects the device-config profile; endpoints and
# credentials are provisioned per target via scripts/device-wallet-config.json.
EXPO_PUBLIC_NETWORK_TARGET=regtest

# Transfer settlement watcher (refreshTransfers loop).
EXPO_PUBLIC_TRANSFER_POLL_INTERVAL_MS=2000
EXPO_PUBLIC_TRANSFER_SETTLE_TIMEOUT_MS=120000

# QVAC on-device voice models: the seam in src/services/metevo/voiceIntent.ts
# resolves a plain intent model per language; a language entry left empty
# falls back to EXPO_PUBLIC_QVAC_INTENT_MODEL.
EXPO_PUBLIC_QVAC_INTENT_MODEL=LLAMA_3_2_1B_INST_Q4_0
# Voice AI agent (src/ai): on-device QVAC models loaded by useVoiceAgent.
# The agent runs English only. Both models resolve from the QVAC model
# registry and download on device (checksum-verified) on first use. A value
# ending in .bin/.gguf instead selects a local model file sideloaded under
# <documents>/models/whisper (scripts/push-whisper-models.cjs) for offline
# use — no push needed for the registry default.
EXPO_PUBLIC_QVAC_WHISPER_MODEL_ENGLISH=WHISPER_EN_SMALL_Q8_0
EXPO_PUBLIC_QVAC_TTS_MODEL=TTS_MULTILINGUAL_SUPERTONIC3_Q8_0
EXPO_PUBLIC_QVAC_TTS_ENGINE=supertonic
EXPO_PUBLIC_QVAC_TTS_VOICE=F1
EXPO_PUBLIC_QVAC_TTS_FALLBACK_LANGUAGE=en
EXPO_PUBLIC_QVAC_TTS_UNLOAD_AFTER_USE=true

# Local P2P link (NFC + Wi-Fi Direct): TCP port the receiver's group
# serves the invoice fetch protocol on (192.168.49.x subnet).
EXPO_PUBLIC_LOCAL_LINK_PORT=48444

# Connectivity secrets (LSP token, bitcoind RPC, RGB endpoints) are NOT
# bundle-embedded. Provision them on the device at runtime:
#   scripts/device-wallet-config.example.json -> scripts/push-device-config.cjs
# The Node-side regtest script has its own env template:
#   scripts/test-metevo-flow.env.example
