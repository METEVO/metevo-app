# Environment for the Node-side regtest workflow only:
#   scripts/test-metevo-flow.cjs  and  tests/e2e/metevo-funding.e2e.js
# These are read directly from process.env by the script - the mobile app
# never sees them (the device gets its LSP auth via the provisioned
# scripts/device-wallet-config.json instead).

# METEVO LSP (utexo-lsp serving the USDm asset)
METEVO_LSP_URL=http://127.0.0.1:8080
METEVO_LSP_BEARER_TOKEN=
METEVO_TEST_USD=100
METEVO_LSP_PEER_PUBKEY=

# Embedded WDK wallet used by the script (test seed, never a real one)
METEVO_WALLET_MNEMONIC=
METEVO_WALLET_PASSWORD=
METEVO_NETWORK=regtest
METEVO_DATA_DIR=./data_metevo_test

# Chain and RGB services reachable from this machine
BITCOIND_RPC_HOST=127.0.0.1
BITCOIND_RPC_PORT=18443
BITCOIND_RPC_USERNAME=
BITCOIND_RPC_PASSWORD=
INDEXER_URL=http://127.0.0.1:3000
PROXY_ENDPOINT=http://127.0.0.1:3001
