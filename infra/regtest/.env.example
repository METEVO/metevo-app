# Regtest stack settings. `./regtest.sh up` copies this file to .env on
# first run, replaces every GENERATE value with a random secret and
# appends BITCOIND_RPCAUTH (delete that line after changing the RPC
# password so it is derived again).

BITCOIND_RPC_USER=metevo
BITCOIND_RPC_PASSWORD=GENERATE
RLN_NODE_PASSWORD=GENERATE

# Build it from the rgb-lightning-node checkout whose openapi.yaml the app
# codes against: docker build -t rgb-lightning-node .
# An image built from June 2026 sources never locks in RGB channels (they
# stay "Opening"); the af03c7f (September 2026) sources work.
RLN_IMAGE=rgb-lightning-node:latest

# Host ports of the two node REST APIs (127.0.0.1 only).
ALICE_API_HOST_PORT=3101
BOB_API_HOST_PORT=3102

# USDm test asset issued by alice (amounts in base units, precision 8).
USDM_TICKER=USDM
USDM_NAME="METEVO Dollar"
USDM_PRECISION=8
USDM_ISSUE_AMOUNT=100000000000

# alice -> bob channel; the push amounts give bob spendable balance too,
# so both phones can pay each other.
CHANNEL_CAPACITY_SAT=100000
CHANNEL_PUSH_MSAT=30000000
CHANNEL_ASSET_AMOUNT=50000000000
CHANNEL_PUSH_ASSET_AMOUNT=10000000000
