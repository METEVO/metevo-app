+/**
+ * Reads the app's native library directory from the device config that
+ * scripts/push-device-config.cjs provisions into the app sandbox
+ * (metevo-wallet-config.json). Returns null when no config was pushed -
+ * the caller then keeps the bundle's linked: addon references unchanged.
+ */
+async function readProvisionedNativeLibraryDir(paths) {
+    const legacy = await import('expo-file-system/legacy');
+    const configUri = `${paths.document.uri}metevo-wallet-config.json`;
+    let raw;
+    try {
+        raw = await legacy.readAsStringAsync(configUri);
+    }
+    catch {
+        return null;
+    }
+    let parsed;
+    try {
+        parsed = JSON.parse(raw);
+    }
+    catch {
+        return null;
+    }
+    return typeof parsed.nativeLibraryDir === 'string' && parsed.nativeLibraryDir.length > 0
+        ? parsed.nativeLibraryDir
+        : null;
+}
